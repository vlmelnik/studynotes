{
  "name": "studynotes",
  "productName": "StudyNotes",
  "version": "1.8.0",
  "description": "Handwritten study notes and PDF annotation",
  "main": "src/main/main.js",
  "author": "vlmelnik",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/notices.js && node scripts/build.js",
    "start": "npm run build && electron .",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e:smoke": "node test/e2e/smoke.js",
    "test:e2e": "node test/e2e/smoke.js && node test/e2e/run.js && node test/e2e/v11.js && node test/e2e/v12.js && node test/e2e/v13.js && node test/e2e/v14.js && node test/e2e/v15.js && node test/e2e/v16.js && node test/e2e/v161.js && node test/e2e/v17.js && node test/e2e/v17b.js && node test/e2e/scan-layout.js && node test/e2e/soak.js && node test/e2e/layout-narrow.js && node test/e2e/extensions-host.js && node test/e2e/extensions-host-v2.js && node test/e2e/mcp.js && node test/e2e/ai.js && node test/e2e/claude-chat.js && node test/e2e/write-notes.js && node test/e2e/dictation.js && node test/e2e/stickers.js && node test/e2e/live-ink.js && node test/e2e/reader.js && node test/e2e/study.js",
    "test:ocr": "node test/e2e/ocr-bench.js",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "dist:win": "node scripts/build.js --minify && electron-builder --win",
    "graph": "graphify update . && graphify cluster-only . --no-label"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "katex": "^0.16.47",
    "nspell": "^2.1.5",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3",
    "tesseract.js": "^7.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "de.studynotes.app",
    "productName": "StudyNotes",
    "copyright": "vlmelnik",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "src/**/*",
      "dist/**/*",
      "!dist/**/*.map",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "StudyNotes-${version}-win-x64.${ext}",
      "files": [
        "package.json",
        "src/**/*",
        "dist/**/*",
        "!dist/**/*.map",
        "assets/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
        "!node_modules/tesseract.js-core/*.wasm.js",
        "!node_modules/tesseract.js/dist/**",
        "!node_modules/tesseract.js-core/*-lstm.{js,wasm}",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/@huggingface/transformers/dist/transformers.{js,min.js,web.js,web.min.js}",
        "!node_modules/@huggingface/transformers/dist/*.mjs",
        "!node_modules/@huggingface/transformers/dist/*.map",
        "!node_modules/@huggingface/transformers/src/**",
        "!node_modules/@huggingface/transformers/types/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudyNotes",
      "artifactName": "StudyNotes-Setup-${version}.exe"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**",
      "assets/models/**",
      "assets/ocr/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "linux": {
      "files": [
        "package.json",
        "src/**/*",
        "dist/**/*",
        "!dist/**/*.map",
        "assets/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/arm64/**",
        "!node_modules/tesseract.js-core/*.wasm.js",
        "!node_modules/tesseract.js/dist/**",
        "!node_modules/tesseract.js-core/*-lstm.{js,wasm}",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/@huggingface/transformers/dist/transformers.{js,min.js,web.js,web.min.js}",
        "!node_modules/@huggingface/transformers/dist/*.mjs",
        "!node_modules/@huggingface/transformers/dist/*.map",
        "!node_modules/@huggingface/transformers/src/**",
        "!node_modules/@huggingface/transformers/types/**"
      ]
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor",
        "icon": "assets/icon.ico"
      }
    ]
  }
}
